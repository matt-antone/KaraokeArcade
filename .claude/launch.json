{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NODE_ENV=development npx tsx watch server/main.ts -p $PORT"
      ],
      "port": 3738,
      "autoPort": true
    },
    {
      "name": "serve",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "KES_PORT=$PORT npm run serve"
      ],
      "port": 3737,
      "autoPort": true
    },
    {
      "name": "dev-test",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "NODE_ENV=development KES_DEV_LOGIN=1 KES_PATH_DATA=.test-data npx tsx watch server/main.ts -p $PORT"
      ],
      "port": 3739,
      "autoPort": true
    }
  ]
}
